<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_ruler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/img_card"
        android:layout_marginTop="24dp"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_card"
        android:text="How much do you height"
        android:textSize="24sp"
        android:id="@+id/tv_title"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:text="This is important information."
        android:textSize="16sp"
        android:id="@+id/tv_message"
        android:textColor="@color/gray_inactive"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edt_scale"
        android:layout_width="0dp"
        android:inputType="number"
        android:maxLength="4"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_kg"
        android:layout_marginTop="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:padding="16dp"
        android:textSize="20sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tv_message"
        android:background="@drawable/edittext_focus"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_kg"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:padding="16dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/button_grey"
        app:layout_constraintTop_toTopOf="@id/edt_scale"
        app:layout_constraintBottom_toBottomOf="@id/edt_scale"
        android:text="Cm"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edt_scale"
        android:text="Eroor"
        android:textColor="@color/pink_active"
        app:layout_constraintStart_toStartOf="@id/edt_scale"
        app:layout_constraintEnd_toEndOf="@id/edt_scale"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:id="@+id/tv_error" />
    <LinearLayout
        android:weightSum="3"
        android:layout_width="0dp"
        android:layout_margin="24dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton
            android:src="@drawable/ic_arrow_back_24"
            android:layout_width="0dp"
            android:background="@drawable/button_around"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:id="@+id/btn_back"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            app:tint="@color/grey" />
        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="Next"
            android:enabled="false"
            android:textAllCaps="false"
            android:padding="16dp"
            android:background="@drawable/button_black" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>